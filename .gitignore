# ==========================================
# Docker & Local Container Persistence
# ==========================================
.docker/
*.log
docker-compose.override.yml

# ==========================================
# Service 1: llm-server (Heavy Model Weights)
# ==========================================
# Ignore large model files and GGUF/binaries across all services
*.gguf
*.bin
*.pt
*.pth
*.safetensors
*.onnx
llm-server/models/*
!llm-server/models/.gitkeep

# ==========================================
# Service 2: vector-db (Persistent Vector Data)
# ==========================================
vector-db/data/*
!vector-db/data/.gitkeep
qdrant_storage/
chroma_db/

# ==========================================
# Service 3: audio-engine (Audio Data & Artifacts)
# ==========================================
# Audio uploads and dataset processing caches
*.wav
*.mp3
*.flac
*.ogg
audio-engine/data/
audio-engine/models/*.onnx
!audio-engine/models/.gitkeep

# ==========================================
# Service 6: mlflow-server (MLflow Artifacts & DB)
# ==========================================
mlflow-server/artifacts/*
!mlflow-server/artifacts/.gitkeep
mlflow.db
mlruns/

# ==========================================
# IDE & Code Editor Configs
# ==========================================
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?